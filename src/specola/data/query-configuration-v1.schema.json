{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "populations", "instances"],
  "properties": {
    "schema": {"const": "specola.queries.v1"},
    "populations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["binding", "arguments"],
        "properties": {
          "binding": {"type": "string", "minLength": 1},
          "arguments": {
            "type": "object",
            "properties": {
              "population": {
                "const": "all",
                "description": "Population-only argument: read the binding's whole population even under a specification scope"
              }
            }
          }
        }
      }
    },
    "instances": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["binding", "id", "operands", "arguments"],
        "properties": {
          "binding": {"type": "string", "minLength": 1},
          "id": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
          "arguments": {"type": "object"},
          "operands": {
            "type": "object",
            "additionalProperties": {"$ref": "#/$defs/operand"}
          }
        }
      }
    }
  },
  "$defs": {
    "operand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "id": {"type": "integer"},
        "name": {"type": "string", "minLength": 1}
      },
      "oneOf": [{"required": ["id"]}, {"required": ["name"]}]
    }
  }
}
